# Supabase (Vercel Storage 연동이 자동으로 넣어 줌)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=

# 서비스 주소 (소셜 로그인 콜백 주소를 고정할 때)
APP_URL=https://wooyeon-table-ten.vercel.app

# 소셜 로그인. 콜백: {APP_URL}/api/auth/{kakao|naver|google}/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PASS 본인인증 (PortOne V2)
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_IDV_CHANNEL_KEY=
PORTONE_API_SECRET=

# 휴대폰 문자 인증 (솔라피). 없으면 시연 모드로 화면에 인증번호를 보여 준다.
# PASS 본인인증이 열리면 온보딩에서 이 단계를 대체한다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# 토스페이먼츠 (API 개별 연동 키: test_ck_/test_sk_ 또는 live_ck_/live_sk_)
# 비워 두면 토스 개발자 문서에 공개된 테스트 키로 결제창·승인·취소가 동작한다 (실제 돈 안 나감)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
